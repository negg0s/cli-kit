{
  "name": "@negg0s/cli-kit",
  "version": "0.1.0",
  "description": "A small TypeScript toolkit for building typed command-line apps.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "create-cli-kit": "./dist/bin/create.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node --input-type=commonjs -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.types.json",
    "examples:check": "tsc -p tsconfig.examples.json",
    "examples:run": "npm run examples:check && node .tmp/examples/examples/ops.js",
    "examples:smoke": "npm run examples:check && node .tmp/examples/examples/ops.js data import sample.csv --tag ci",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  }
}
